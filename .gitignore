# Local environment settings and secrets (at any directory level).
.env
.env.*
!.env.example
!.env.*.example
secrets/
*.key
*.pem
*.p12
*.pfx

# Python environments and generated caches.
.venv/
.venv*/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Generated test reports and coverage output.
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/

# Local test suites: keep on disk, exclude from Git.
/backend/tests/
/frontend/tests/

# Uploaded files, database storage, backups, and runtime logs.
/backend/uploads/*
!/backend/uploads/.gitkeep
/database/pgdata/
/database/backups/
/backups/
*.dump
*.backup
*.log
/logs/

# Frontend dependencies and generated output.
node_modules/
/frontend/dist/
/frontend/build/
.vite/
.parcel-cache/

# Personal editor settings and temporary editor files.
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~

# Operating-system temporary files.
.DS_Store
Thumbs.db
Desktop.ini

# Local business reports.
/AGENTS.md
/docs/BAO_CAO_NGHIEP_VU.md
/docs/TONG_HOP_PHAN_TICH_NGHIEP_VU.txt
/docs
/output