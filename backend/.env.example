POSTGRES_PASSWORD='medical_db'
DB_PASSWORD='medical_db'
SECRET_KEY="medical_security_serect_key_"
# 1 chỉ cho môi trường demo: mở API /demo/payments/{id}/result, không bật gửi email.
# BANK/CARD/EWALLET trong dự án đều là mô phỏng, không có ngân hàng thật.
SEND_EMAIL=1
SEND_SMS=1
# SEND_SMS=1 chỉ in OTP SMS giả lập trong log backend, không gửi SMS thật.
FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500

# Chatbot AI demo. Điền khóa vào backend/.env, không đưa lên Git hoặc frontend.
# Không có khóa: giao diện tự chuyển sang tra cứu cơ bản và ghi rõ chế độ.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Trinh dien OTP quen mat khau tren giao dien (0 = tat)
DEMO_PASSWORD_RECOVERY=0

# Real Gmail SMTP. Enter credentials only in backend/.env (never commit secrets).
# SEND_EMAIL above remains a legacy payment-demo flag, not the SMTP switch.
EMAIL_ENABLED=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
PUBLIC_SITE_URL=http://127.0.0.1:3000
